# flextunnel server config (TOML).
#
# Load with:  flextunnel server start -c server.toml
#         or: flextunnel server start --default-config   (~/.config/flextunnel/server.toml)
#
# CLI flags override these values. Unknown keys are rejected.

# Server identity key — always a file (generate with `flextunnel
# generate-iroh-key -o server.key`); there is no inline variant.
secret_file = "./server.key"

# Authorized client public keys — always a file (ssh authorized_keys style).
# One `flxtpubv1:...` per line, optional trailing comment; `#` lines
# ignored. Clients generate a keypair with `flextunnel generate-auth-private-key`
# and you paste the printed PUBLIC key here (the secret never leaves the
# client).
authorized_keys_file = "./authorized_keys"

# Optional iroh tuning.
# Custom relay(s) for failover. Configuring custom relays disables n0 internet
# discovery (pkarr/DNS) — clients reach the server via relay hints instead; mDNS
# local-network discovery stays on. relay_auth_token is an optional shared bearer
# token sent to every custom relay's WebSocket upgrade; it is only valid with
# custom relay_urls (rejected with the default iroh relays).
# relay_urls = ["https://relay.example"]
# relay_auth_token = "shared-relay-secret"

# Optional INBOUND bridging: allow other flextunnel servers to bridge INTO this
# server (the inbound counterpart to the [bridges.*] OUTBOUND routes at the
# bottom of this file). The allowlist is the sole bridge credential: a
# connecting bridge's endpoint id (TLS-authenticated by iroh, no extra proof
# needed) must be listed here, enforced natively at the handshake. An
# empty/absent allowlist disables inbound bridging entirely. Bridged-in
# targets must also be on this server's routed set (routed_domains/routed_cidrs
# below). This is a top-level key, so it must appear BEFORE the [tables]
# below (bare keys after a [table] header would bind to that table).
# allowed_bridge_servers = ["<endpoint id of the bridging server>"]

# Duplicate-id blocklist (JSON). This path is fixed at
# ~/.config/flextunnel/blocklist.json and is deliberately not configurable. The
# server records confirmed duplicate client ids here, and its own id if it
# detects it is a duplicate server; on the next start it refuses to run if its
# id is listed. Delete the offending entry after resolving the conflict.

# Routed set (the "tunnel set") — REQUIRED. This is a VPN-style split-tunnel
# "included routes" list and the single source of truth: it is pushed to every
# client during the handshake (clients tunnel on-list targets and direct-connect
# off-list ones) AND enforced here as a defense-in-depth whitelist — the server
# REJECTS any tunnel request whose target is not on the list (SOCKS5 reply 0x02,
# "connection not allowed by ruleset"). Note the asymmetry: clients fall back to
# a direct connection for off-list targets, whereas the server rejects them
# outright. The server refuses to start with an empty tunnel set. Clients
# configure no routed set of their own.
#
# Domain entries are exact (`example.com`), wildcard (`*.example.com`, subdomains
# only — not the bare apex), or `*` to match every hostname; case-insensitive.
# CIDR entries match IP targets, accept a bare IP as a single host, and a default
# route (`0.0.0.0/0` / `::/0`) matches every IP. Hostnames are matched only
# against `routed_domains` and IPs only against `routed_cidrs` — a numeric
# IP literal is always gated by `routed_cidrs` even if a client sends it in
# hostname form, so `*` never lets a raw IP through.
#
# Only the COMBINED set must be non-empty — setting just one list is fine. The
# two never cross: an omitted/empty list means that whole category is off-list
# and always direct-connected. So `routed_domains` alone (no `routed_cidrs`)
# tunnels those hostnames but direct-connects every bare-IP target, and
# `routed_cidrs` alone tunnels those IPs but direct-connects every hostname.
# If you use `host_aliases`, add the alias name itself to the routed set here:
# filtering happens on the requested hostname before the server rewrites it.
#
# For a FULL tunnel (route all traffic through the tunnel), use the catch-alls:
#   routed_domains = ["*"]
#   routed_cidrs = ["0.0.0.0/0", "::/0"]
#
# NOTE: these are top-level keys, so they must appear BEFORE the [host_aliases]
# table below (in TOML, bare keys after a [table] header belong to that table).
routed_domains = ["*.example.com", "httpbin.org"]
routed_cidrs = ["10.0.0.0/8", "192.168.1.5"]

# RESERVED namespace: `flextunnel.internal` and any `*.flextunnel.internal`
# subdomain are reserved by flextunnel and cannot be used as [host_aliases]
# names (the server rejects such configs at startup). Clients
# always tunnel these names regardless of the routed set. Browse to
# `http://flextunnel.internal/` through the tunnel for the HTML server status
# page, or query the plain-text form from a client with:
#   curl -sS -x socks5h://127.0.0.1:1080 http://flextunnel.internal/status.txt
# HTTP-only. Other `*.flextunnel.internal` names are reserved for future use and
# return a 404.

# Optional host aliases, resolved server-side. A requested hostname matching a
# key (case-insensitive) is rewritten to its value — an IP or another hostname
# on the server's network — keeping the requested port, then resolved/connected
# like any other target. Lets clients reach the server's loopback or internal
# hosts via a real name, which also avoids Firefox's refusal to proxy literal
# `localhost`/`127.0.0.1` (use `socks5h://` / remote DNS so the name reaches the
# server). Only domain targets are aliased; literal IPs pass through unchanged.
#
# A key is an exact hostname or a `*.suffix` wildcard (subdomains only, apex
# excluded — the same syntax as routed_domains). An exact key wins over any
# wildcard, and the most specific (longest-suffix) wildcard wins among wildcards.
#
# For an IPv6 value, write the address BARE — no brackets, no port. Brackets
# (`[::1]`) are only for embedding a port in one string; here the requested port
# is kept separately, so `[::1]` would fail to parse. A link-local address needs
# a zone id (`fe80::1%eth0`).
# [host_aliases]
# "server.internal" = "127.0.0.1"      # -> the server's own loopback (IPv4)
# "node2.internal"  = "192.168.1.50"   # -> another host on the server's network
# "*.svc.internal"  = "192.168.1.60"   # -> wildcard: any subdomain of svc.internal
# "server6.internal" = "::1"           # -> the server's own loopback (IPv6, bare)
# "node6.internal"   = "2001:db8::50"  # -> another host, global IPv6 (bare)

# Optional conditional DNS forwarding (split-DNS), applied server-side when the
# server resolves a tunneled hostname. By default the server uses its own system
# resolver for every name; a [dns_forwards] entry overrides that for names under
# a given suffix, sending them to a specific upstream DNS server instead. This
# lets clients reach internal names that only a particular (e.g. internal) DNS
# server knows how to resolve.
#
# Each key is a BARE domain suffix and each value a list of DNS servers (`IP` or
# `IP:port`, default port 53). A hostname that equals the suffix or is a
# subdomain of it (on a label boundary) is resolved via that suffix's server(s);
# everything else keeps using the system resolver. Matching is case-insensitive
# and most-specific-first (a longer suffix wins over a shorter one). List
# multiple servers for redundancy; TCP fallback is used automatically.
#
# The suffix must be reachable through the routed set above — add it (or a
# `*.suffix` wildcard) to routed_domains, since the whitelist is enforced on the
# requested hostname before resolution. The server REFUSES TO START if a
# [dns_forwards] suffix is not covered by routed_domains (it would be a no-op).
# [dns_forwards]
# "local.168234.xyz" = ["10.0.0.53"]              # -> internal resolver on :53
# "corp.example.com" = ["10.1.0.10:5353", "10.1.0.11"]  # custom port + failover

# Optional OUTBOUND bridge routes: forward matching targets to ANOTHER
# flextunnel server over a persistent server-to-server connection (split-tunnel
# across servers), instead of dialing them from this server's network. The
# matched target is forwarded VERBATIM — the target server applies its own
# host_aliases and dns_forwards, resolves domain targets on its side, and
# re-enforces its own routed set. Single hop: a stream that arrived over a
# bridge is never bridged again, so two servers bridging at each other cannot
# loop.
#
# Each entry needs the target server's endpoint id and at least one rule; no
# credential — this server dials out with its own server identity, and that
# TLS-authenticated endpoint id is what the target server must list in ITS
# allowed_bridge_servers. Rules use the routed-set syntax above (domains:
# exact, `*.x`, or `*`; cidrs: CIDR or bare IP). Checked BEFORE
# [host_aliases]/local dialing; when several bridges match, the first in name
# order wins. Every rule must be reachable through the routed set above (the
# whitelist runs first), or the server refuses to start. The upstream
# connection is maintained with reconnect/backoff; while it is down, matching
# requests fail as host-unreachable.
# [bridges.lab]
# endpoint_id = "<endpoint id of the target server>"
# domains = ["*.svc"]
# cidrs = ["fd34::/64"]

# INBOUND bridging (letting other flextunnel servers bridge INTO this one) is
# configured via the top-level `allowed_bridge_servers` key near the top of
# this file — top-level keys must precede the [tables] above, so it can't live
# down here beside the outbound routes.
